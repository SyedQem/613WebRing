---
/**
 * Marks a link that opens in a new tab (`target="_blank"`), so the change of
 * context is announced before it happens (WCAG 3.2.5): a small arrow for
 * sighted visitors and "(opens in a new tab)" for screen readers. Place it as
 * the last child of the link.
 */
interface Props {
  /** Hide the visual arrow where the layout has no room for it. */
  icon?: boolean;
}
const { icon = true } = Astro.props;
---

{
  icon && (
    <svg
      class="new-tab-icon"
      viewBox="0 0 12 12"
      width="0.72em"
      height="0.72em"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M3.5 2.5h6v6M9.5 2.5 2.5 9.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}<span class="visually-hidden"> (opens in a new tab)</span>
