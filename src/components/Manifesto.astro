---
/**
 * "How the ring works" — a pinned scene (CSS sticky) that reveals the statement
 * one beat at a time as you scroll (each fades out as the next arrives), beside
 * a rotating ASCII ring.
 *
 * The statement is ordinary server-rendered text, fully visible by default. The
 * script then picks one of three presentations:
 *   scrub  — wide screens with motion on: words are tied to scroll position.
 *   stack  — narrow screens with motion on: no pin; the lines rise in once
 *            when the section scrolls into view, and stay.
 *   static — motion off (OS setting or the footer control): nothing moves.
 * Nothing ever disappears on a timer, so the text can always be read at the
 * visitor's own pace (WCAG 2.2.1 / 2.2.3).
 *
 * Styles live under MANIFESTO SCENE in global.css.
 */
const PHRASES = [
  "Start anywhere.",
  "Keep clicking.",
  "Tour every builder in the 613",
  "and land right back where you began.",
];

// Each phrase ("beat") owns a slice of scroll. Its words cascade in within that
// slice, then the whole beat fades out as the next one arrives — so beats reveal
// one at a time and the screen never shows all of them at once. The final beat
// stays. Timings are precomputed since the phrases are static.
const N = PHRASES.length;
const SLOT = 1 / N;
const WORDS_IN = SLOT * 0.55;

const lines = PHRASES.map((phrase, k) => {
  const words = phrase.split(" ");
  const start = k * SLOT;
  const inMark = start + 0.03;
  const outStart = (k + 1) * SLOT - 0.04;
  const outEnd = (k + 1) * SLOT + 0.02;
  const isLast = k === N - 1;
  return {
    // Opacity envelope as "progress:opacity" stops: hidden before the beat,
    // present during it, gone once the next beat takes over (the last beat
    // holds at full opacity to the end).
    stops: isLast
      ? [
          [start, 0],
          [inMark, 1],
        ]
      : [
          [start, 0],
          [inMark, 1],
          [outStart, 1],
          [outEnd, 0],
        ],
    words: words.map((w, j) => {
      const wStart = start + (j / words.length) * WORDS_IN;
      return {
        w,
        from: wStart,
        to: Math.min(wStart + 0.05, outStart - 0.005),
        highlight: w.includes("613"),
      };
    }),
  };
});
const fmt = (n: number) => n.toFixed(4);
---

<section id="manifesto" class="manifesto" data-section-glow>
  <div class="manifesto-sticky">
    <div class="container manifesto-grid">
      <div class="manifesto-visual">
        <canvas class="manifesto-ring" data-label="613" aria-hidden="true"
        ></canvas>
      </div>
      <div class="manifesto-copy">
        <p class="eyebrow">How the ring works</p>
        <h2 class="manifesto-statement">
          {
            lines.map((line, i) => (
              <span
                class="m-line"
                style={`--i:${i}`}
                data-stops={line.stops
                  .map(([x, y]) => `${fmt(x)}:${y}`)
                  .join(",")}
              >
                {line.words.map((word) => (
                  <span
                    class:list={["m-word", { "m-word-hl": word.highlight }]}
                    data-from={fmt(word.from)}
                    data-to={fmt(word.to)}
                  >
                    {word.w}{" "}
                  </span>
                ))}
              </span>
            ))
          }
        </h2>
      </div>
    </div>
  </div>
</section>

<script>
  import { motionOn, onMotionChange } from "../lib/motion-pref";

  type Mode = "static" | "stack" | "scrub";

  const section = document.getElementById("manifesto");

  /* ---- The statement -------------------------------------------------- */
  if (section) {
    const compact = window.matchMedia("(max-width: 900px)");
    const lines = Array.from(
      section.querySelectorAll<HTMLElement>(".m-line"),
    ).map((el) => ({
      el,
      stops: (el.dataset.stops || "")
        .split(",")
        .map((s) => s.split(":").map(Number) as [number, number]),
      last: "",
    }));
    const words = Array.from(
      section.querySelectorAll<HTMLElement>(".m-word"),
    ).map((el) => ({
      el,
      from: Number(el.dataset.from),
      to: Number(el.dataset.to),
      last: -1,
    }));

    /** Piecewise-linear interpolation through `stops`, clamped at both ends. */
    const interpolate = (stops: [number, number][], p: number) => {
      if (p <= stops[0][0]) return stops[0][1];
      for (let i = 1; i < stops.length; i++) {
        const [x1, y1] = stops[i];
        if (p <= x1) {
          const [x0, y0] = stops[i - 1];
          return y0 + ((p - x0) / (x1 - x0 || 1)) * (y1 - y0);
        }
      }
      return stops[stops.length - 1][1];
    };

    let mode: Mode = "static";
    let ticking = false;
    let stackObserver: IntersectionObserver | null = null;

    const scrub = () => {
      ticking = false;
      if (mode !== "scrub") return;
      // Progress runs 0 → 1 from "section top at viewport top" to "section
      // bottom at viewport bottom", i.e. for exactly as long as it is pinned.
      const rect = section.getBoundingClientRect();
      const range = rect.height - window.innerHeight;
      const p = range > 0 ? Math.min(1, Math.max(0, -rect.top / range)) : 1;

      for (const line of lines) {
        const v = interpolate(line.stops, p).toFixed(3);
        if (v !== line.last) {
          line.last = v;
          line.el.style.opacity = v;
        }
      }
      for (const word of words) {
        const t = Math.min(
          1,
          Math.max(0, (p - word.from) / (word.to - word.from || 1)),
        );
        if (t !== word.last) {
          word.last = t;
          word.el.style.opacity = t.toFixed(3);
          word.el.style.transform = `translateY(${((1 - t) * 14).toFixed(2)}px)`;
        }
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(scrub);
    };

    const clearInline = () => {
      for (const line of lines) {
        line.last = "";
        line.el.style.removeProperty("opacity");
      }
      for (const word of words) {
        word.last = -1;
        word.el.style.removeProperty("opacity");
        word.el.style.removeProperty("transform");
      }
    };

    const apply = () => {
      const next: Mode = !motionOn()
        ? "static"
        : compact.matches
          ? "stack"
          : "scrub";
      if (next === mode) return;

      // Leave the old mode…
      if (mode === "scrub") {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
        clearInline();
      }
      stackObserver?.disconnect();
      stackObserver = null;

      // …enter the new one.
      mode = next;
      if (mode === "static") {
        section.removeAttribute("data-mode");
        return;
      }
      section.setAttribute("data-mode", mode);
      if (mode === "scrub") {
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        scrub();
      } else if (!section.classList.contains("is-in")) {
        stackObserver = new IntersectionObserver(
          (entries, io) => {
            if (entries.some((e) => e.isIntersecting)) {
              section.classList.add("is-in");
              io.disconnect();
            }
          },
          { threshold: 0.25 },
        );
        stackObserver.observe(section);
      }
    };

    apply();
    compact.addEventListener("change", apply);
    onMotionChange(apply);
  }

  /* ---- The ring -------------------------------------------------------
     A slowly rotating ring of `0 1 3 6` glyphs with `613` held in the centre —
     the scene's visual metaphor for the webring. Draws only while it is on
     screen, the tab is visible and motion is on; otherwise it holds a single
     still frame. */
  const canvas = section?.querySelector<HTMLCanvasElement>(".manifesto-ring");
  const ctx = canvas?.getContext("2d");

  if (canvas && ctx) {
    const label = canvas.dataset.label || "613";
    const glyphs = "0136";
    const outerCount = 40;
    const innerCount = 26;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    // The real family names behind the design tokens (they are generated at
    // build time, so they can't be hard-coded here).
    const css = getComputedStyle(document.documentElement);
    const mono = css.getPropertyValue("--font-mono").trim() || "monospace";
    const display =
      css.getPropertyValue("--font-display").trim() || "sans-serif";

    let width = 0;
    let height = 0;
    let size = 0;
    let raf = 0;
    let running = false;
    let onScreen = false;

    const ring = (
      t: number,
      count: number,
      radius: number,
      dir: number,
      cx: number,
      cy: number,
      fontSize: number,
    ) => {
      ctx.font = `${fontSize}px ${mono}`;
      for (let k = 0; k < count; k++) {
        const a = (k / count) * Math.PI * 2 + t * 0.12 * dir;
        const x = cx + Math.cos(a) * radius;
        const y = cy + Math.sin(a) * radius;
        const shimmer = 0.45 + 0.55 * Math.sin(t * 1.4 + k * 0.6);
        ctx.globalAlpha = 0.18 + 0.5 * shimmer;
        ctx.fillText(glyphs[(k + Math.floor(t * 2)) % glyphs.length], x, y);
      }
    };

    const draw = (now: number) => {
      if (!size) return;
      const t = now / 1000;
      const cx = width / 2;
      const cy = height / 2;
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = "rgb(210,214,226)";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      ring(t, outerCount, size * 0.42, 1, cx, cy, size * 0.05);
      ring(t, innerCount, size * 0.3, -1, cx, cy, size * 0.042);

      ctx.globalAlpha = 1;
      ctx.fillStyle = "rgb(240,242,248)";
      ctx.font = `600 ${size * 0.16}px ${display}`;
      ctx.fillText(label, cx, cy + size * 0.005);
    };

    const frame = (now: number) => {
      if (!running) return;
      draw(now);
      raf = requestAnimationFrame(frame);
    };

    /** Run the loop only when there is something to see. */
    const sync = () => {
      const shouldRun = motionOn() && onScreen && !document.hidden;
      if (shouldRun === running) return;
      running = shouldRun;
      cancelAnimationFrame(raf);
      if (running) raf = requestAnimationFrame(frame);
      else draw(0);
    };

    new ResizeObserver(() => {
      const r = canvas.getBoundingClientRect();
      if (r.width === width && r.height === height) return;
      width = r.width;
      height = r.height;
      size = Math.min(width, height);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (!running) draw(0);
    }).observe(canvas);

    new IntersectionObserver((entries) => {
      onScreen = entries[entries.length - 1].isIntersecting;
      sync();
    }).observe(canvas);

    document.addEventListener("visibilitychange", sync);
    onMotionChange(sync);
    // A still frame is drawn once; redraw it when the web fonts arrive.
    document.fonts?.ready.then(() => {
      if (!running) draw(0);
    });
  }
</script>
