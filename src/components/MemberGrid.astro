---
import MemberCard from "./MemberCard.astro";
import { members, allTags, memberCount } from "../lib/members";

// Compact list used by the client-side fuzzy search.
const searchList = members.map((m) => ({
  id: m.id,
  name: m.name,
  role: m.role ?? "",
  domain: m.domain,
  blurb: m.blurb ?? "",
  tags: m.tags ?? [],
}));
---

<section id="members" class="section">
  <div class="container">
    <header class="md-head">
      <p class="eyebrow">The directory</p>
      <h2 class="section-title" data-reveal="fade">
        {memberCount} builders in the 613
      </h2>
      <p class="lead" data-reveal="fade">
        Everyone shipping software out of Ottawa — students, founders, hobbyists
        and seasoned engineers. Search by name, stack or neighbourhood.
      </p>
    </header>

    <div
      class="md-controls"
      role="search"
      aria-label="Member directory"
      data-reveal
    >
      <label class="search" for="member-search">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"
          ></circle>
          <path
            d="m20 20-3.2-3.2"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <input
          id="member-search"
          type="search"
          placeholder="Search builders, stacks, the 613…"
          autocomplete="off"
          aria-label="Search members"
        />
      </label>

      {
        allTags.length > 0 && (
          <div class="md-tags" role="group" aria-label="Filter by tag">
            <button
              class="chip tap-target is-active"
              type="button"
              data-tag=""
              aria-pressed="true"
            >
              All
            </button>
            {allTags.map((t) => (
              <button
                class="chip tap-target"
                type="button"
                data-tag={t}
                aria-pressed="false"
              >
                {t}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <p class="md-count" id="member-count" role="status">
      Showing all {memberCount} sites
    </p>

    <div class="member-grid" id="member-grid" data-reveal-stagger>
      {members.map((m) => <MemberCard member={m} />)}
    </div>

    <p class="md-empty" id="member-empty" hidden>
      No builders match that yet — try a broader search, or <a href="/join"
        >add yourself to the ring</a
      >.
    </p>
  </div>
</section>

<script
  type="application/json"
  id="members-data"
  is:inline
  set:html={JSON.stringify(searchList)}
/>

<style>
  .md-head {
    max-width: 60ch;
    margin-bottom: 2rem;
  }
  .md-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 260px;
    max-width: 380px;
    padding: 0.7rem 1rem;
    background: var(--surface);
    /* A field's edge is what identifies it, so it needs 3:1 (WCAG 1.4.11). */
    border: 1px solid var(--border-ui);
    border-radius: 999px;
    color: var(--text-subtle);
    transition: border-color 0.18s var(--ease);
  }
  /* The input's own outline is suppressed, so the pill carries the focus ring
     — the same 2px ring every other control gets (WCAG 2.4.13). */
  .search:focus-within {
    border-color: var(--blue);
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .search input {
    border: none;
    background: transparent;
    outline: none;
    width: 100%;
    font: inherit;
    color: var(--text);
  }
  .search input::placeholder {
    color: var(--text-subtle);
    opacity: 1;
  }
  /* Chips keep their compact look; `.tap-target` stretches each one's hit
     area to 44px, and the row gap leaves room so those areas never overlap. */
  .md-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 0.4rem;
    padding-block: 0.45rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    min-width: var(--tap);
    padding: 0.38rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      background-color 0.15s var(--ease),
      color 0.15s var(--ease),
      border-color 0.15s var(--ease);
  }
  .chip:hover {
    border-color: var(--blue);
    color: var(--text);
  }
  .chip.is-active {
    background: #f5f5f5;
    border-color: #f5f5f5;
    color: #050505;
  }
  .md-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--text-subtle);
    margin-bottom: 1.4rem;
  }
  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.1rem;
  }
  .md-empty {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    color: var(--text-muted);
    padding: 2.5rem 1rem;
  }
</style>

<script>
  import type Fuse from "fuse.js";

  type Entry = {
    id: string;
    name: string;
    role: string;
    domain: string;
    blurb: string;
    tags: string[];
  };

  const dataEl = document.getElementById("members-data");
  const grid = document.getElementById("member-grid");
  const input = document.getElementById(
    "member-search",
  ) as HTMLInputElement | null;
  const countEl = document.getElementById("member-count");
  const emptyEl = document.getElementById("member-empty");
  if (dataEl && grid && input && countEl && emptyEl) {
    const entries: Entry[] = JSON.parse(dataEl.textContent || "[]");
    const total = entries.length;
    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>(".member-card"),
    );
    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".chip"),
    );

    // The fuzzy-search library is only needed once someone actually searches,
    // so it is fetched on first interest (focus / hover) instead of on every
    // page load.
    let fuse: Fuse<Entry> | null = null;
    let loading: Promise<void> | null = null;
    const loadFuse = () =>
      (loading ??= import("fuse.js").then(({ default: FuseCtor }) => {
        fuse = new FuseCtor(entries, {
          keys: [
            { name: "name", weight: 3 },
            { name: "role", weight: 2 },
            { name: "tags", weight: 2 },
            { name: "domain", weight: 1 },
            { name: "blurb", weight: 1 },
          ],
          threshold: 0.38,
          ignoreLocation: true,
        });
      }));

    let query = "";
    let activeTag = "";

    /** Ids matching the query, or null for "no query — everything matches". */
    const search = (): Set<string> | null => {
      const q = query.trim();
      if (!q) return null;
      if (fuse) return new Set(fuse.search(q).map((r) => r.item.id));
      // Library still on its way: plain substring match for now; `apply` runs
      // again with fuzzy results the moment it lands.
      const needle = q.toLowerCase();
      return new Set(
        cards
          .filter((c) => (c.dataset.search || "").includes(needle))
          .map((c) => c.dataset.id || ""),
      );
    };

    const apply = () => {
      const matchIds = search();

      let visible = 0;
      for (const card of cards) {
        const id = card.dataset.id || "";
        const tags = (card.dataset.tags || "").split(",").filter(Boolean);
        const okSearch = matchIds === null || matchIds.has(id);
        const okTag = activeTag === "" || tags.includes(activeTag);
        const show = okSearch && okTag;
        card.hidden = !show;
        if (show) visible++;
      }

      emptyEl.hidden = visible !== 0;
      countEl.textContent =
        visible === total
          ? `Showing all ${total} sites`
          : `Showing ${visible} of ${total} sites`;
    };

    input.addEventListener("focus", loadFuse, { once: true });
    input.addEventListener("pointerenter", loadFuse, { once: true });
    input.addEventListener("input", () => {
      query = input.value;
      apply();
      if (!fuse) loadFuse().then(apply, () => {});
    });

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        activeTag = chip.dataset.tag || "";
        for (const c of chips) {
          const on = c === chip;
          c.classList.toggle("is-active", on);
          c.setAttribute("aria-pressed", String(on));
        }
        apply();
      });
    }
  }
</script>
