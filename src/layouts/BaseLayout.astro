---
import "../styles/global.css";
import { Font, getImage } from "astro:assets";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import AmbientBackdrop from "../components/AmbientBackdrop.astro";
import AsciiField from "../components/AsciiField.astro";
import BootLoader from "../components/BootLoader.astro";
import logo from "../assets/bco-logo.png";
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL } from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** Path-relative or absolute OG image. */
  image?: string;
  /** Keep transient/utility pages out of search indexes. */
  noindex?: boolean;
  /** Drop the nav + footer chrome (used by the redirector page). */
  bare?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og.png?v=2",
  noindex = false,
  bare = false,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${SITE_NAME}`
  : `${SITE_NAME} · Ottawa's builders, ringed`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;
// A tab-sized rendition of the mark (the full PNG in /public is ~90 KB).
const favicon = await getImage({ src: logo, width: 96, format: "png" });
---

<!doctype html>
<html lang="en" data-motion={bare ? "off" : "on"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080808" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={favicon.src} />

    <!-- Fonts: self-hosted (see `fonts` in astro.config.mjs). The two families
         that paint above the fold are preloaded; the mono face is not. -->
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          // The visitor's own choice from the footer's "Pause animations"
          // control (src/lib/motion-pref.ts) — honoured before first paint.
          var paused = false;
          try {
            paused = localStorage.getItem("613:motion") === "off";
          } catch (e) {}
          if (paused) root.setAttribute("data-motion-user", "off");
          if (
            root.getAttribute("data-motion") === "on" &&
            !paused &&
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            root.classList.add("motion");
            // Failsafe: `.motion` arms the hidden pre-reveal states, but the
            // reveals live in a module script. If that module never boots
            // (failed fetch, unsupported browser), strip the class so content
            // renders visible instead of staying trapped at opacity 0.
            setTimeout(function () {
              if (!root.hasAttribute("data-motion-ready")) {
                root.classList.remove("motion");
              }
            }, 4000);
            if (sessionStorage.getItem("613:booted") !== "1") {
              root.classList.add("booting");
              // Failsafe: never trap the page if hydration fails to complete.
              setTimeout(function () {
                root.classList.remove("booting");
              }, 6000);
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a class="skip-link" href="#main">
            Skip to content
          </a>
          <BootLoader />
          <AsciiField />
          <AmbientBackdrop />
          <Nav />
          <main id="main" tabindex="-1">
            <slot />
          </main>
          <Footer />
        </>
      )
    }

    <script>
      import { initMotion } from "../lib/motion";
      initMotion();
    </script>
  </body>
</html>
